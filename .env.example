# ============================================
# Cloud Cost Optimization Hub - Environment Variables
# ============================================

# Application Settings
ENV=development
PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL + TimescaleDB)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ccoh
DB_PASSWORD=ccoh123
DB_NAME=ccoh

# Redis (for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRY_HOURS=24

# ============================================
# Cloud Provider Credentials (Optional for MVP)
# Add only the clouds you want to test with
# ============================================

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP
GCP_PROJECT_ID=
GCP_CREDENTIALS_JSON=  # Service account JSON as a string

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ============================================
# Alerting (Email)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@ccoh.local

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8080